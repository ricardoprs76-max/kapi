rules_version = '2';

// Reglas de la base de datos de Kapi (Cloud Firestore).
// - users/{uid}: la copia de los datos de cada persona; solo ella (su sesión de Google en Kapi) puede leerla o escribirla.
// - shared/{shareId}: una cuenta compartida. Solo la ven y la editan los correos de "members"; solo quien la creó
//   ("owner") puede invitar o quitar personas y borrarla. Nadie puede listar todas las cuentas compartidas.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /parts/{part} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /shared/{shareId} {
      function email() { return request.auth.token.email; }

      allow read: if request.auth != null && email() in resource.data.members;

      allow create: if request.auth != null
        && request.resource.data.owner == email()
        && request.resource.data.members == [email()];

      allow update: if request.auth != null
        && email() in resource.data.members
        && request.resource.data.owner == resource.data.owner
        && (email() == resource.data.owner || request.resource.data.members == resource.data.members);

      allow delete: if request.auth != null && email() == resource.data.owner;
    }
  }
}
